[Unit]
Description=Club Telegram channel listener bot
After=network.target mysql.service
Requires=mysql.service

[Service]
User=clubapp
WorkingDirectory=/opt/clubapp/bot
Environment=PYTHONIOENCODING=utf-8
ExecStart=/opt/clubapp/bot/venv/bin/python main.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
